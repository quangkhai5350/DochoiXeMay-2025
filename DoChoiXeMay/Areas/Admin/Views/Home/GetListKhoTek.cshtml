@using DoChoiXeMay.Models;

@model Kho
<div class="table-responsive">
    <table class="table table-hover table-striped" style="margin-bottom:0">
        <thead>
            <tr class="canhgiua" style="background-color: #00bcd4">
                <th class="canhgiua">Id</th>
                <th class="canhgiua">Tên Kho</th>
                <th class="canhgiua">GhiChu</th>
                <th class="canhgiua">Sử Dụng</th>
                <th class="canhgiua">Ngày</th>

                <th class="canhgiua">Update</th>
            </tr>
        </thead>

        <tbody style="border: 2px solid black !important">
            @foreach (DoChoiXeMay.Models.Kho Item in ViewBag.GetListKhoTek)
            {
                <tr class="canhgiua" style="border-bottom: 2px solid black !important">
                    <td>@Item.Id</td>
                    <td>@Item.TenKho</td>
                    <td>@Item.GhiChu</td>
                    <td>@Item.SuDung</td>
                    <td>
                        @Item.Ngay
                    </td>

                    <td>
                        @if (int.Parse(Session["quyen"].ToString()) < 5)
                        {
                            if (Item.Id > 1)
                            {
                                <a style="display:none" class="btn btn-warning" onclick="return confirm('Bạn muốn xóa Kho: @Item.TenKho ??')" href="/Admin/Home/DeleteKho/@Item.Id"><span class="glyphicon glyphicon-trash"></span></a>
                            }
                            <a class="btn btn-danger" href="/Admin/Home/UpdateKho/@Item.Id"><span class="glyphicon glyphicon-edit"></span></a>
                        }
                    </td>
                </tr>

            }
        </tbody>


    </table>

</div>


