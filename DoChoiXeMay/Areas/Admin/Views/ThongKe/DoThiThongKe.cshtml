
<input id="phantramdaban" value="@ViewBag.phantramdaban" hidden />
<input id="phantramTraHangLeLoi" value="@ViewBag.phantramTraHangLeLoi" hidden />
<input id="phantramTongtraBH" value="@ViewBag.phantramTongtraBH" hidden />
<input id="phantramTonkho" value="@ViewBag.phantramTonkho" hidden />
<input id="phantramMauDaXuat" value="@ViewBag.phantramMauDaXuat" hidden />

<input id="DaBanTikTok" value="@Session["DaBanTikTok"].ToString()" hidden />
<input id="DaBanShopee" value="@Session["DaBanShopee"].ToString()" hidden />
<input id="DaBanLeNSan" value="@Session["DaBanLeNSan"].ToString()" hidden />
<input id="DaBanSiNSan" value="@Session["DaBanSiNSan"].ToString()" hidden />

<div id="chartContainer" style="height: 300px; width: 100%;"></div>
<div id="chartContainer2" style="height: 300px; width: 100%;"></div>
<script>
    window.onload = function () {
        const daban = $("#phantramdaban").val().replace(',', '.')
        const tdaban = parseFloat(daban).toFixed(2);  
        var TraHangLeLoi = $("#phantramTraHangLeLoi").val().replace(',', '.')
        var tTraHangLeLoi = parseFloat(TraHangLeLoi)
        var traBH = $("#phantramTongtraBH").val().replace(',', '.')
        var ttraBH = parseFloat(traBH)
        var Tonkho = $("#phantramTonkho").val().replace(',', '.')
        var tTonkho = parseFloat(Tonkho)
        var MauDaXuat = $("#phantramMauDaXuat").val().replace(',', '.')
        var tMauDaXuat = parseFloat(MauDaXuat)

        var chart = new CanvasJS.Chart("chartContainer", {
            animationEnabled: true,
            title: {
                text: "Xi Nhan Wave TNT BLOCKX G2 ZEN 1"
            },
            data: [{
                type: "pie",
                startAngle: 240,
                yValueFormatString: "##0.00\"%\"",
                indexLabel: "{label} {y}",
                dataPoints: [
                    { y: tdaban, label: "Đã Bán" },
                    { y: tTraHangLeLoi, label: "TraHangLeLoi" },
                    { y: ttraBH, label: "Trả BH" },
                    { y: tTonkho, label: "Tồn kho" },
                    { y: tMauDaXuat, label: "Hàng Mẫu" }
                ]
            }]
        });
        const TikTok = $("#DaBanTikTok").val()
        var tTikTok = parseInt(TikTok);
        const Shopee = $("#DaBanShopee").val()
        var tShopee = parseInt(Shopee);
        const LeNSan = $("#DaBanLeNSan").val()
        var tLeNSan = parseInt(LeNSan);
        const SiNSan = $("#DaBanSiNSan").val()
        var tSiNSan = parseInt(SiNSan);

        var chart2 = new CanvasJS.Chart("chartContainer2", {
            theme: "light1", // "light2", "dark1", "dark2"
            animationEnabled: true, // change to true		
            title: {
                text: "Đã Bán"
            },
            data: [
                {
                    // Change type to "bar", "area", "spline", "pie",etc.
                    type: "column",
                    dataPoints: [
                        { label: "Lẽ NSan", y: tLeNSan },
                        { label: "Shopee", y: tShopee },
                        { label: "TikTok", y: tTikTok },
                        { label: "Sỉ", y: tSiNSan },
                    ]
                }
            ]
        });
        chart.render();
        chart2.render();
    }
</script>
