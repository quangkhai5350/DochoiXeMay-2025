@model DoChoiXeMay.Models.KyTonKho

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layoutadmin.cshtml";
}
<script src="~/Areas/Admin/Content/jquery2.0.3.min.js"></script>
<style>
    .canhgiua {
        text-align: center !important;
    }
    .marginbutonkh {
        margin-top: 50%;
    }
</style>
<div class="row">
    <div class="Title_Notin" style="text-align:center">
        <span class="">Bảng Thống Kê Tổng Hợp TeK</span>
    </div>
</div>
<div class="container" style="width:100%;background-color: white; margin-top: 20px; border-radius: 4px 4px; box-shadow: 0px 2px 4px 0px rgba(0,0,0,0.32);">
    <div class="omb_login col-lg-3 col-xl-3 col-md-3 col-sm-12 col-sx-12 col-12" style="padding-top: 20px">
        <p>(Đã sx = Tồn Kho + Đã Bán + Hàng Mẫu = @ViewBag.DaSanXuat)</p>
        <p style="background-color:bisque">_Tổng xinhan Gen1 Tồn Kho: @ViewBag.TongXiNhanGen1Tek</p>

        <p style="margin-left:2%">+ XiNhan Trong Tồn Kho: @ViewBag.TongXiNhanGen1TrongTK</p>
        <p style="margin-left:2%">+ XiNhan Khói Tồn Kho: @ViewBag.TongXiNhanGen1KhoiTK</p>
        <hr style="width:40%" />
        <p style="background-color:bisque">_Tổng XiNhan Gen1 Đã Bán:@ViewBag.daban</p>
        <p>(TikTok: @ViewBag.DaBanTikTok, Shopee: @ViewBag.DaBanShopee, Ngoài Sàn: @ViewBag.DaBanLeNSan, Bán Sỉ: @ViewBag.DaBanLSiNSan)</p>

        <p style="margin-left:2%">+ XiNhan Trong đã bán:@ViewBag.TongXiNhanGen1TrongDaBan</p>
        <p style="margin-left:10%">* XiNhan trong đã bán TikTok:@ViewBag.TongXiNhanGen1TrongDaBanTikTok</p>
        <p style="margin-left:10%">* XiNhan trong đã bán Shoppe:@ViewBag.TongXiNhanGen1trongDaBanShopee</p>
        <p style="margin-left:10%">* XiNhan trong đã bán lẻ Ngoài Sàn:@ViewBag.TongXiNhanGen1trongDaBanLeNSan</p>
        <p style="margin-left:10%">* XiNhan trong đã bán Sỉ :@ViewBag.TongXiNhanGen1trongDaBanSiNSan</p>

        <p style="margin-left:2%">+ XiNhan Khói đã bán:@ViewBag.TongXiNhanGen1KhoiDaBan</p>
        <p style="margin-left:10%">* XiNhan khói đã bán TikTok:@ViewBag.TongXiNhanGen1KhoiDaBanTikTok</p>
        <p style="margin-left:10%">* XiNhan khói đã bán Shoppe:@ViewBag.TongXiNhanGen1KhoiDaBanShopee</p>
        <p style="margin-left:10%">* XiNhan khói đã bán lẻ Ngoài Sàn:@ViewBag.TongXiNhanGen1KhoiDaBanLeNSan</p>
        <p style="margin-left:10%">* XiNhan khói đã bán Sỉ :@ViewBag.TongXiNhanGen1KhoiDaBanSiNSan</p>
        <hr />
        <p style="background-color:bisque">_Tổng XiNhan Gen1 Mẫu Đã Xuất:@ViewBag.TongXiNhanGen1MauDaXuat</p>
        <p style="margin-left:2%">+ XiNhan Trong Mẫu Đã Xuất: @ViewBag.TongXiNhanGen1TrongMauDaXuat</p>
        <p style="margin-left:2%">+ XiNhan Khói Mẫu Đã Xuất: @ViewBag.TongXiNhanGen1KhoiMauDaXuat</p>
        <hr />
        <p style="background-color:burlywood">_Tổng XiNhan Gen1 Khách Lẻ trả hàng:@ViewBag.DaTraHangKhachLe</p>
        <p style="margin-left:2%">+ XiNhan Trong Khách Lẻ trả hàng: @ViewBag.DaTraHangKhachLeTrong</p>
        <p style="margin-left:2%">+ XiNhan Khói Khách Lẻ trả hàng: @ViewBag.DaTraHangKhachLeKhoi</p>
    </div>
</div>
    <div class="panel panel-default" style="margin-top:10px">
        <div class="panel-heading">
            <div class="row">
                <div class="pull-right label label-primary" style="margin-bottom: 5px; color: white; font-family: monospace; font-weight: bold; font-size: large">
                    @Session["ThongBaoKyTonKhoOK"]
                </div>
                <div class="pull-right label label-warning" style="margin-bottom: 5px; color: white; font-family: monospace; font-weight: bold; font-size: large">

                    @Session["ThongBaoKyTonKhoLoi"]
                </div>
                <div class="row">
                    @if (Session["quyen"].ToString() == "1")
                    {
                        <div class="col-lg-12 col-xl-12 col-md-12 col-sm-12">
                            <a class="btn btn-warning" style="margin-left:20px" href="/Admin/ThongKe/InsertKyTonKho" onclick="return confirm('Bạn muốn Thêm Mới Kỳ Tồn Kho ??')"><i class="fa fa-plus-circle"></i>&nbsp;&nbsp; Thêm mới "Kỳ Tồn Kho"</a>

                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="panel-body">
            @*<img id="loading" hidden src="~/Areas/Admin/Content/img/loading.gif" />*@
            <div class="listKTK">


            </div>
        </div>
        <div class="panel-footer">

            @*<ul class="pager">
                    <li><a href="#"><span class="glyphicon glyphicon-step-backward"></span></a></li>
                    <li><a href="#"><span class="glyphicon glyphicon-chevron-left"></span></a></li>
                    <li><a href="#"><span class="glyphicon glyphicon-chevron-right"></span></a></li>
                    <li><a href="#"><span class="glyphicon glyphicon-step-forward"></span></a></li>
                </ul>*@

        </div>
    </div>
    <script>
        LoadPage();
        function LoadPage() {
            $.ajax({
                url: "/Admin/ThongKe/GetListKyTonKho",
                data: {},
                success: function (respone) {
                    $(".listKTK").html(respone);
                }
            });
        };
    </script>

