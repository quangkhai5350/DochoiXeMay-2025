@model DoChoiXeMay.Models.NV_NhanVienTek

@{
    ViewBag.Title = "UpdateNhanVien";
    Layout = "~/Areas/Admin/Views/Shared/_Layoutadmin.cshtml";
}
<link href="~/Areas/Admin/Content/css/Info_Style.css" rel="stylesheet" />
<script src="~/Areas/Admin/Content/jquery2.0.3.min.js"></script>
<div class="container">
    <h2>Update Thông Tin NV @Model.HoTen</h2>
    @using (Html.BeginForm("NhanVien", "UpdateNhanVien", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <fieldset class="info_form" style="margin-top:0">
            <div class="container">
                @Html.HiddenFor(kh => kh.Id)
                @Html.HiddenFor(kh => kh.STT)
                @Html.HiddenFor(kh => kh.IdUser)
                @Html.HiddenFor(kh => kh.HinhDaiDien)
                <h1 class="info_header">
                    <span class="pull-right label label-warning" style="color:white;font-family:monospace">
                        @Html.ValidationSummary()
                    </span>
                </h1>
                <div class="contentform">
                    <div class="leftcontact">
                        <div class="form-group">
                            <div class="row">
                                <div class="col-sm-8">
                                    <p>Họ và Tên **</p>
                                    <span class="icon-case"><i class="glyphicon glyphicon-user"></i></span>
                                    @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", style = "height: 40px", @required = true })
                                </div>
                                <div class="col-sm-2" style="text-align:center">
                                    <p>Nam</p>
                                    @Html.CheckBoxFor(m => m.GioiTinh, new { @style = "height:20px;margin-left: 10%" })
                                </div>
                                <div class="col-sm-2" style="text-align:center">
                                    <p>Đã Nghỉ</p>
                                    @Html.CheckBoxFor(m => m.DaNghiViec, new { @style = "height:20px;margin-left: 10%" })
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="row">
                                <div class="col-sm-8">
                                    <p>CCCD ** </p>
                                    <span class="icon-case"><i class="glyphicon glyphicon-user"></i></span>
                                    @Html.TextBoxFor(m => m.CCCD, new { @class = "form-control", style = "height: 40px", @required = true })
                                </div>
                                <div class="col-sm-4">
                                    <p>SDT ** </p>
                                    @Html.TextBoxFor(m => m.Sdt, new { @class = "form-control", style = "height: 40px", @required = true })
                                </div>
                            </div>


                        </div>
                        <div class="form-group">
                            <div class="row">
                                <div class="col-sm-8">
                                    <p>Địa Chỉ thường trú **</p>
                                    <span class="icon-case"><i class="glyphicon glyphicon-home"></i></span>
                                    @Html.TextBoxFor(m => m.DiaChiThuongTru, new { @class = "form-control", style = "height: 40px", @required = true })
                                </div>
                                <div class="col-sm-4" style="">
                                    <p>Khu Vực</p>
                                    @Html.DropDownList("IdKhuVucThuongTru", null, new { style = "width: 100%; height: 40px" })
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <p>Địa Chỉ Hiện Tại ** </p>
                            <span class="icon-case"><i class="glyphicon glyphicon-hourglass"></i></span>
                            @Html.TextBoxFor(m => m.DiaChiHienTai, new { @class = "form-control", style = "height: 40px", @required = true })
                        </div>
                        <div class="form-group">
                            <p>Công Việc </p>
                            <span class="icon-case"><i class="glyphicon glyphicon-ice-lolly-tasted"></i></span>
                            @Html.TextBoxFor(m => m.CongViec, new { @class = "form-control", style = "height: 40px" })
                        </div>
                        <div class="form-group">
                            <div class="row">
                                <div class="col-sm-6">
                                    <p>Bằng Cấp Chính </p>
                                    <span class="icon-case"><i class="glyphicon glyphicon-education"></i></span>
                                    @Html.TextBoxFor(m => m.BangCapChinh, new { @class = "form-control", style = "height: 40px" })
                                </div>
                                <div class="col-sm-6">
                                    <p>Bằng Cấp Phụ </p>
                                    <span class="icon-case"><i class="glyphicon glyphicon-education"></i></span>
                                    @Html.TextBoxFor(m => m.BangCapPhu, new { @class = "form-control", style = "height: 40px" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="rightcontact">
                        @*<div class="row">
                            <div class="col-sm-9">
                                <div class="form-group">
                                    <p>Hình Đại Diện (giới hạn 7MB) <span></span></p>
                                    <span class="icon-case"><i class="glyphicon glyphicon-info-sign"></i></span>
                                    <input type="file" name="Dinhkem1" id="Dinhkem1" />
                                    <p id="thongbaosite1" style="color:red; display:none">File quá lớn !!!</p>

                                </div>
                            </div>
                            <div class="col-sm-3">
                                @if (File.Exists(Request.MapPath("~/Content/imgTeK/" + Model.HinhDaiDien)))
                                {
                                    <img class="img-responsive img-thumbnail" src="~/Content/imgTeK/@Model.HinhDaiDien" style="max-width:100%;max-height:100px" />
                                }
                            </div>
                        </div>*@
                        <div class="row">
                            <div class="col-sm-9">
                                <div class="form-group">
                                    <p>Hình CC trước (giới hạn 7MB) <span></span></p>
                                    <span class="icon-case"><i class="glyphicon glyphicon-info-sign"></i></span>
                                    <input type="file" name="Dinhkem2" id="Dinhkem2" />
                                    <p id="thongbaosite2" style="color:red; display:none">File quá lớn !!!</p>
                                    @Html.HiddenFor(kh => kh.HinhCanCuocTruoc)
                                </div>
                            </div>
                            <div class="col-sm-3">
                                @if (File.Exists(Request.MapPath("~/Content/imgTeK/" + Model.HinhCanCuocTruoc)))
                                {
                                    <img class="img-responsive img-thumbnail" src="~/Content/imgTeK/@Model.HinhCanCuocTruoc" style="max-width:100%;max-height:80px" />
                                }
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-9">
                                <div class="form-group">
                                    <p>Hình CC sau (giới hạn 7MB) <span></span></p>
                                    <span class="icon-case"><i class="glyphicon glyphicon-info-sign"></i></span>
                                    <input type="file" name="Dinhkem3" id="Dinhkem3" />
                                    <p id="thongbaosite3" style="color:red; display:none">File quá lớn !!!</p>
                                    @Html.HiddenFor(kh => kh.HinhCanCuocSau)
                                </div>
                            </div>
                            <div class="col-sm-3">
                                @if (File.Exists(Request.MapPath("~/Content/imgTeK/" + Model.HinhCanCuocSau)))
                                {
                                    <img class="img-responsive img-thumbnail" src="~/Content/imgTeK/@Model.HinhCanCuocSau" style="max-width:100%;max-height:80px" />
                                }
                            </div>
                        </div>
                        <script>
                            var kt1 = true;
                            var kt2 = true;
                            var kt3 = true;
                            $('#Dinhkem1').bind('change', function () {
                                //this.files[0].size gets the size of your file.
                                var size = this.files[0].size;
                                const file = Math.round((size / 1024));
                                if (file >= 7200) {
                                    $("#thongbaosite1").css('display', 'block');
                                    kt1 = false;
                                    KtLuu();
                                } else {
                                    $("#thongbaosite1").css('display', 'none')
                                    kt1 = true;
                                    KtLuu();
                                }
                            });
                            $('#Dinhkem2').bind('change', function () {
                                //this.files[0].size gets the size of your file.
                                var size = this.files[0].size;
                                const file = Math.round((size / 1024));
                                if (file >= 7200) {
                                    $("#thongbaosite2").css('display', 'block');
                                    kt2 = false;
                                    KtLuu();
                                } else {
                                    $("#thongbaosite2").css('display', 'none')
                                    kt2 = true;
                                    KtLuu();
                                }
                            });
                            $('#Dinhkem3').bind('change', function () {
                                //this.files[0].size gets the size of your file.
                                var size = this.files[0].size;
                                const file = Math.round((size / 1024));
                                if (file >= 7200) {
                                    $("#thongbaosite3").css('display', 'block');
                                    kt3 = false;
                                    KtLuu();
                                } else {
                                    $("#thongbaosite3").css('display', 'none')
                                    kt3 = true;
                                    KtLuu();
                                }
                            });
                            function KtLuu() {
                                if (kt1 == true && kt2 == true && kt3 == true) {
                                    document.getElementById('btnLuu').disabled = false;
                                } else {
                                    document.getElementById('btnLuu').disabled = true;
                                }
                            }

                        </script>
                        <div class="form-group">
                            <div class="row">
                                <div class="col-sm-10">
                                    <p>Vị trí nhân viên</p>
                                    <span class="icon-case"><i class="glyphicon glyphicon-subtitles"></i></span>
                                    @Html.DropDownList("IdVitrinhanvien", null, new { style = "width: 100%; height: 40px" })
                                </div>
                                <div class="col-sm-2" style="text-align:center">
                                    <p>Thử Việc</p>
                                    @Html.CheckBoxFor(m => m.ThuViec, new { @style = "height:20px;margin-left: 10%" })
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <p>Tin Học </p>
                            <span class="icon-case"><i class="glyphicon glyphicon-education"></i></span>
                            @Html.TextBoxFor(m => m.TinHoc, new { @class = "form-control", style = "height: 40px" })
                        </div>
                        <div class="form-group">
                            <div class="col-sm-6">
                                <p>Ngày Vào Cty</p>
                                <span class="icon-case"><i class="glyphicon glyphicon-time"></i></span>
                                @Html.TextBoxFor(kh => kh.NgayTao, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", style = "height: 40px" })
                            </div>
                            <div class="col-sm-6">
                                <p>Ngày Lên Lương</p>
                                <span class="icon-case"><i class="glyphicon glyphicon-time"></i></span>
                                @Html.TextBoxFor(kh => kh.NgayUpdate, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", style = "height: 40px" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-sm-12">
                            <div class="text-center btn-crud">
                                <button id="btnLuu" class="btn btn-warning" data-action="UpdateNhanVien"><span class="glyphicon glyphicon-refresh"></span>&nbsp;Update NV</button>
                                <a class="btn btn-primary" href="/Admin/NhanVien/ListNhanVien" style="margin-left:10%"><span class="glyphicon glyphicon-arrow-left"></span>&nbsp;Quay Lại</a>
                            </div>
                            <script>
                                $(function () {
                                    $("button[data-action]").click(function () {
                                        if (!confirm("Bạn Có Chắc Chắn Hành Động Của Mình?")) {
                                            return false;
                                        } else {
                                            var action = $(this).attr("data-action");
                                            this.form.action = "/Admin/NhanVien/" + action;
                                        }

                                    });
                                });
                            </script>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>

    }
</div>

