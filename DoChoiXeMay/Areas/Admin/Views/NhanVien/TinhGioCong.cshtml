@{
    ViewBag.Title = "ListThuChiTeK";
    Layout = "~/Areas/Admin/Views/Shared/_Layoutadmin.cshtml";
}
<script src="~/Areas/Admin/Content/jquery2.0.3.min.js"></script>
<style>
    .canhgiua {
        text-align: center !important;
    }
</style>
<div class="row">
    <div class="Title_Notin" style="text-align:center">
        <span>Tính Công Theo Giờ</span>
    </div>
</div>
<div class="panel panel-default" style="margin-top:10px">
    <div class="panel-heading">
        <div class="row">
            <div class="pull-right label label-warning" style="margin-bottom: 5px; color: white; font-family: monospace; font-weight: bold; font-size: large">
                @Session["ThongBaoGioCongTEKLoi"]
            </div>
            <div class="pull-right label label-success" style="margin-bottom: 5px; color: white; font-family: monospace; font-weight: bold; font-size: large">
                @Session["ThongBaoGioCongTEK"]
            </div>
            <div class="row" style="margin-top:20px">
                <div class="col-lg-6 col-xl-6 col-md-4 col-sm-12 col-12">
                    <input style="margin-left: 10px; margin-bottom: 10px" type="month" name="ThangNam" value="@DateTime.Now.ToString("yyyy-MM")" id="ThangNam" />
                </div>
                <div class="col-lg-6 col-xl-6 col-md-4 col-sm-12 col-12" style="margin-bottom: 10px">
                    @Html.DropDownList("Idnhanvien", null, new { style = "width: 70%; height: 30px;margin-left: 10px" })
                </div>
            </div>
            <div id="ListTinhGio">

            </div>

        </div>
        </div>
    </div>
<script>
    Load();
    function Load() {
        InsertAutoNgayThang();
    }
    function InsertAutoNgayThang() {
        var tn = $('#ThangNam').val();
        var Idnv = $('#Idnhanvien').val();
        $.ajax({
            url: "/Admin/NhanVien/InsertAutoNgayThang",
            type: 'POST',
            datatype: 'JSON',
            contentType: 'application/json;charset=utf-8;',
            data: JSON.stringify({ dtInput: tn, Id: Idnv }),
            async: true,
            success: function (res) {
                GetListTinhGio();
            }, error: function (err) {
                GetListTinhGio();
                console.log(err, ':Loi Check Thêm Ngày Tháng');
            }
        });
    }
    function GetListTinhGio() {
        var tn = $('#ThangNam').val();
        var Idnv = $('#Idnhanvien').val();
        $.ajax({
            url: "/Admin/NhanVien/GetListTinhGioCong",
            data: { dtInput: tn, Id: Idnv },
            success: function (respone) {
                $("#ListTinhGio").html(respone);
                //var pagesp = pageNo + 1;
                //$('.TongSanPham').html(pagesp + '/' + TongSP + ' trang');
            }, error: function (err) {
                console.log(err, ':Loi get List');
            }
        });
    }
    $("#ThangNam").change(function () {
        var tn = $('#ThangNam').val();
        var Idnv = $('#Idnhanvien').val();
        InsertAutoNgayThang();
        //var tn = $('#ThangNam').val();
        //var namTh = tn.split("-");
        //khi load trang ==> controler ==> tạo ra n dòng(số ngày trong tháng đến hiện tại)
        //Khi đổi nhân viên ==> controler ==> tạo ra n dòng(số ngày trong tháng đến hiện tại)
    });
    $("#Idnhanvien").change(function () {
        var tn = $('#ThangNam').val();
        var Idnv = $('#Idnhanvien').val();
        InsertAutoNgayThang();
    });
</script>
