@{
    ViewBag.Title = "ListThuChiTeK";
    Layout = "~/Areas/Admin/Views/Shared/_Layoutadmin.cshtml";
}
<script src="~/Areas/Admin/Content/jquery2.0.3.min.js"></script>
<style>
    .canhgiua {
        text-align: center !important;
    }
</style>
<div class="row">
    <div class="Title_Notin" style="text-align:center">
        <span>Tính Công Theo Giờ</span>
    </div>
</div>
<div class="panel panel-default" style="margin-top:10px">
    <div class="panel-heading">
        <div class="row">
            <div class="pull-right label label-warning" style="margin-bottom: 5px; color: white; font-family: monospace; font-weight: bold; font-size: large">
                @Session["ThongBaoUserTEK"]
            </div>
            <div class="row" style="margin-top:20px">
                    <div class="col-lg-6 col-xl-6 col-md-6 col-sm-12 col-12" style="text-align: center">
                        <span class="icon-case"><i class="glyphicon glyphicon-calendar"></i>Chọn Tháng Năm</span>
                        <input type="date" name="ThangNam" value="@DateTime.Now.ToString("yyyy-MM-dd")" id="ThangNam" />
                    </div>
                    <div class="col-lg-6 col-xl-6 col-md-6 col-sm-12 col-12" style="text-align: center">
                        <span class="icon-case"><i class="glyphicon glyphicon-calendar"></i>Chọn Nhân Viên</span>
                        @Html.DropDownList("IdVitrinhanvien", null, new { style = "width: 70%; height: 30px" })
                    </div>
            </div>
            <div class="row">
                <div class="table-responsive">
                    <table class="table table-hover table-striped" style="margin-bottom:0">
                        <thead>
                            <tr class="canhgiua" style="background-color: #00bcd4">
                                <th class="canhgiua" style="max-width: 15px">STT</th>
                                <th class="canhgiua">Tên Sản Phẩm</th>
                                <th class="canhgiua">Loại</th>
                                <th class="canhgiua">Số Lượng</th>
                                <th class="canhgiua" style="width:230px">Giá Nhập Cuối</th>

                                <th class="canhgiua" style="max-width: 40px;padding:0">Img 1</th>
                                <th class="canhgiua" style="max-width: 40px; padding: 0">Img 2</th>
                                <th class="canhgiua" style="max-width: 40px; padding: 0">Img 3</th>
                                <th class="canhgiua" style="min-width: 30px">Update</th>
                            </tr>
                        </thead>
