@model DoChoiXeMay.Models.NV_GioCong

@using (Html.BeginForm("EditGioCong", "NhanVien", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    <h4>
        Ngày @Html.EditorFor(model => model.Day, new { htmlAttributes = new { @style = "width: 15% !important", @disabled = true } })/
        @Html.EditorFor(model => model.Month, new { htmlAttributes = new { @style = "width: 15% !important", @disabled = true } })/
        @Html.EditorFor(model => model.Year, new { htmlAttributes = new { @style = "width: 15% !important", @disabled = true } })
    </h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.GhiChu)
    @Html.HiddenFor(model => model.NgayUpdate)
    @Html.HiddenFor(model => model.IdNhanVien)
    @Html.HiddenFor(model => model.Day)
    @Html.HiddenFor(model => model.Month)
    @Html.HiddenFor(model => model.Year)
    <div class="form-group">
        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.GioVaoSang, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    <input name="VaoSang" value="@Model.GioVaoSang.TimeOfDay" class = "form-control" type="time"/>
                    @Html.HiddenFor(kh => kh.GioVaoSang)
                    @Html.ValidationMessageFor(model => model.GioVaoSang, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.GioRaSang, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    <input name="RaSang" value="@Model.GioRaSang.TimeOfDay" class="form-control" type="time" />
                    @Html.HiddenFor(kh => kh.GioRaSang)
                    @Html.ValidationMessageFor(model => model.GioRaSang, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <hr />
    <div class="form-group">
        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.GioVaoChieu, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    <input name="VaoChieu" value="@Model.GioVaoChieu.TimeOfDay" class="form-control" type="time" />
                    @Html.HiddenFor(kh => kh.GioVaoChieu)
                    @Html.ValidationMessageFor(model => model.GioVaoChieu, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.GioRaChieu, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    <input name="RaChieu" value="@Model.GioRaChieu.TimeOfDay" class="form-control" type="time" />
                    @Html.HiddenFor(kh => kh.GioRaChieu)
                    @Html.ValidationMessageFor(model => model.GioRaChieu, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <hr />
    <div class="form-group">
        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.GioVaoTangCa, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    <input name="VaoTangCa" value="@Model.GioVaoTangCa.TimeOfDay" class="form-control" type="time" />
                    @Html.HiddenFor(kh => kh.GioVaoTangCa)
                    @Html.ValidationMessageFor(model => model.GioVaoTangCa, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.GioRaTangCa, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    <input name="RaTangCa" value="@Model.GioRaTangCa.TimeOfDay" class="form-control" type="time" />
                    @Html.HiddenFor(kh => kh.GioRaTangCa)
                    @Html.ValidationMessageFor(model => model.GioRaTangCa, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <hr />
    <div class="form-group">
        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.GioVaoLe, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    <input name="VaoLe" value="@Model.GioVaoLe.TimeOfDay" class="form-control" type="time" />
                    @Html.HiddenFor(kh => kh.GioVaoLe)
                    @Html.ValidationMessageFor(model => model.GioVaoLe, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.GioRaLe, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    <input name="RaLe" value="@Model.GioRaLe.TimeOfDay" class="form-control" type="time" />
                    @Html.HiddenFor(kh => kh.GioRaLe)
                    @Html.ValidationMessageFor(model => model.GioRaLe, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <hr />
    <div class="row" style="margin-top:10px">
        <div class="form-group col-sm-12">
            <div class="text-center btn-crud">
                <button id="btnLuu" class="btn btn-warning" data-action="EditGioCong"><span class="glyphicon glyphicon-refresh"></span>&nbsp;Update</button>

            </div>
            <script>
                $(function () {
                    $("button[data-action]").click(function () {
                        if (!confirm("Bạn Có Chắc Chắn Hành Động Của Mình?")) {
                            return false;
                        } else {
                            var action = $(this).attr("data-action");
                            this.form.action = "/Admin/NhanVien/" + action;
                        }

                    });
                });
            </script>
        </div>
    </div>
</div>
}
