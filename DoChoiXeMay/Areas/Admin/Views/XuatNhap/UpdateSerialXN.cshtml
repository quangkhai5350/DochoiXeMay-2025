@model DoChoiXeMay.Models.ChitietXuatNhap

@{
    ViewBag.Title = "UpdateSerialXN";
    Layout = "~/Areas/Admin/Views/Shared/_Layoutadmin.cshtml";
}
<link href="~/Areas/Admin/Content/css/Info_Style.css" rel="stylesheet" />
<script src="~/Areas/Admin/Content/jquery2.0.3.min.js"></script>
<div class="container">
    <h2>EditVideo</h2>
    @using (Html.BeginForm("UpdateSerialXN","XuatNhap", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <fieldset class="info_form" style="margin-top:0">
            <div class="container">
                @Html.HiddenFor(kh => kh.Id)
                @Html.HiddenFor(kh => kh.Ten)
                @Html.HiddenFor(kh => kh.IdKy)
                @Html.HiddenFor(kh => kh.Gianhap)
                @Html.HiddenFor(kh => kh.NgayAuto)
                @Html.HiddenFor(kh => kh.Hinh1)
                @Html.HiddenFor(kh => kh.Hinh2)
                @Html.HiddenFor(kh => kh.Hinh3)
                @Html.HiddenFor(kh => kh.IDMF)
                @Html.HiddenFor(kh => kh.IDColor)
                @Html.HiddenFor(kh => kh.IDSize)
                @Html.HiddenFor(kh => kh.GhiChu)
                @Html.HiddenFor(kh => kh.DaActive)
                @Html.HiddenFor(kh => kh.TraHangKhachLe)
                <h1 class="info_header">
                    <span style="color:black">Update @Model.Ten</span>
                    <span class="pull-right label label-warning" style="color:white;font-family:monospace">
                        @Html.ValidationSummary()
                    </span>
                </h1>
                <div class="contentform">
                    <div class="form-group">
                        <div class="row" style="width:95%;padding-left:15px">
                            <p>SoLuong </p>
                            <span class="icon-case"><i class="glyphicon glyphicon-user"></i></span>
                            @Html.TextBoxFor(kh => kh.SoLuong, new { @class = "form-control", @type = "number", style = "height: 40px", @required = true })

                        </div>
                        <div class="row" style="width:95%;padding-left:15px">
                            <p>SerialHop </p>
                            <span class="icon-case"><i class="glyphicon glyphicon-expand"></i></span>
                            @Html.TextBoxFor(kh => kh.SerialHop, new { @class = "form-control", style = "height: 40px", @required = true })

                        </div>
                        <div class="row" style="width:95%;padding-left:15px">
                            <p>SerialSP </p>
                            <span class="icon-case"><i class="glyphicon glyphicon-expand"></i></span>
                            @Html.TextBoxFor(kh => kh.SerialSP, new { @class = "form-control", style = "height: 40px", @required = true })

                        </div>
                        <div class="row" style="margin-top:10px">
                            <div class="form-group col-sm-12">
                                <div class="text-center btn-crud">
                                    <button id="btnLuu" class="btn btn-warning" data-action="UpdateSerialXN"><span class="glyphicon glyphicon-refresh"></span>&nbsp;Update</button>
                                    <a class="btn btn-primary" href="/Admin/XuatNhap/ListXuatNhapTeK" style="margin-left:10%"><span class="glyphicon glyphicon-arrow-left"></span>&nbsp;Quay Lại</a>
                                </div>
                                <script>
                                    $(function () {
                                        $("button[data-action]").click(function () {
                                            if (!confirm("Bạn Có Chắc Chắn Hành Động Của Mình?")) {
                                                return false;
                                            } else {
                                                var action = $(this).attr("data-action");
                                                this.form.action = "/Admin/XuatNhap/" + action;
                                            }

                                        });
                                    });
                                </script>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </fieldset>
    }
</div>

