        $.ajax({
            url: "/Admin/Cong_ThanhToan/GetListThanhToan",
            data: {},
            success: function (respone) {
                $(".listThanhToan").html(respone);
                //var pagesp = pageNo + 1;
                //$('.TongSanPham').html(pagesp + '/' + TongSP + ' trang');
            }
        });
    };
