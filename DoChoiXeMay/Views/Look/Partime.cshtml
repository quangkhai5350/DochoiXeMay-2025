@using DoChoiXeMay.Models
@{
    ViewBag.Title = "Partime";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.0/css/bootstrap.min.css">

<link href="~/Content/Login_Style.css" rel="stylesheet" />
<div class="" style="width:100%;background-color: white; margin-top: 80px; border-radius: 4px 4px; box-shadow: 0px 2px 4px 0px rgba(0,0,0,0.32)">
    <h3 style="text-align:center;margin-bottom:20px"><a style="text-decoration: none">Xem Giờ Công NV Partime TeK</a></h3>
    <h5 style="text-align:center;margin-bottom:20px"><a style="text-decoration: none">(NV chỉ có thể thay đổi giờ trong ngày.)</a></h5>
    <div class="row" style="">
        <div class="col-lg-6 col-xl-6 col-md-4 col-sm-12 col-12">
            <input style="margin-left: 10px; margin-bottom: 10px" type="month" name="ThangNam" value="@DateTime.Now.ToString("yyyy-MM")" id="ThangNam" />
        </div>
        <div class="col-lg-6 col-xl-6 col-md-4 col-sm-12 col-12" style="margin-bottom: 10px">
            @Html.DropDownList("Idnhanvien", null, new { style = "width: 70%; height: 30px;margin-left: 10px" })
        </div>
    </div>
    <div class="listGioCongNV">

    </div>
</div>
<div class="" style="width:100%;background-color: white; margin-top: 80px; border-radius: 4px 4px; box-shadow: 0px 2px 4px 0px rgba(0,0,0,0.32)">
    <h3 style="text-align:center"><a style="text-decoration: none">Lịch làm việc tuần của NV Partime TeK</a></h3>
    <div class="row" style="margin-top:20px;margin-bottom:10px">

        <div class="col-lg-4 col-xl-4 col-md-4 col-sm-6" style="margin-top:10px">
            <select class="form-control" id="SelectW" name="SelectW" style="width: 70%; height: 40px; margin: 0 auto">
                <option value="@ViewBag.Tuanmoihon">Tuần @ViewBag.Tuanmoihon</option>
                <option value="@ViewBag.Tuanmoi">Tuần @ViewBag.Tuanmoi</option>
                <option value="@ViewBag.TuanHT" selected>Tuần(@ViewBag.TuanHT) Hiện tại</option>
                <option value="@ViewBag.TuanCu">Tuần @ViewBag.TuanCu</option>
            </select>
        </div>
        <input id="CheckTHT" value="@ViewBag.TuanHT" hidden />
    </div>
    <div class="listLichTuanNV">

    </div>
</div>

<script src="//ajax.googleapis.com/ajax/libs/jquery/1.9.1/jquery.min.js"></script>
<script>
    Load();
    function Load() {
        GetListTinhGio()
        GetListTuan()
    }
    function GetListTinhGio() {
        var tn = $('#ThangNam').val();
        var Idnv = $('#Idnhanvien').val();
        $.ajax({
            url: "/Look/GetListTinhGioCong",
            data: { dtInput: tn, Id: Idnv },
            success: function (respone) {
                $(".listGioCongNV").html(respone);
                //var pagesp = pageNo + 1;
                //$('.TongSanPham').html(pagesp + '/' + TongSP + ' trang');
            }, error: function (err) {
                console.log(err, ':Loi get List');
            }
        });
    }
    $("#ThangNam").change(function () {
        var tn = $('#ThangNam').val();
        var Idnv = $('#Idnhanvien').val();
        GetListTinhGio();
    });
    $("#Idnhanvien").change(function () {
        var tn = $('#ThangNam').val();
        var Idnv = $('#Idnhanvien').val();
        GetListTinhGio();
    });
    function GetListTuan() {
        var week = $('#SelectW').val();
        $.ajax({
            url: "/Look/GetListTuan",
            data: { tuanht: week },
            success: function (respone) {
                $(".listLichTuanNV").html(respone);
                //var pagesp = pageNo + 1;
                //$('.TongSanPham').html(pagesp + '/' + TongSP + ' trang');
            }, error: function (err) {
                console.log(err, ':Loi get List');
            }
        });
    }
    $("#SelectW").change(function () {
        var week = $('#SelectW').val();
        GetListTuan();
    });
</script>
