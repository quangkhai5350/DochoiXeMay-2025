@model DoChoiXeMay.Models.NV_NhanVienTek

@{
    ViewBag.Title = "_ChangeInFo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.0/css/bootstrap.min.css">
<link href="~/Areas/Admin/Content/css/Info_Style.css" rel="stylesheet" />
@*<link href="~/Content/Login_Style.css" rel="stylesheet" />*@
<script src="~/Areas/Admin/Content/jquery2.0.3.min.js"></script>
<div class="container" style="width:100%;background-color: white; margin-top: 150px; border-radius: 4px 4px; box-shadow: 0px 2px 4px 0px rgba(0,0,0,0.32);">
    <div class="omb_login">
        <div class="row" style="text-align:center">
            <span style="font-size:15px" class="pull-right label label-warning">@Session["ThongbaoSthanhcong"]</span>
        </div>
    </div>
    @if (Model != null)
    {
        <div class="omb_login" style="text-align:center">
            <h3><a style="text-decoration: none">Xem và Update thông tin NhanVien: @Model.HoTen</a></h3>
        </div>
    }
    @using (Html.BeginForm("_ChangeInFoStaffJson", "AccountWeb", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <div class="row">
            <div class="col-xs-12 col-md-12" style="padding-bottom:10px">
                <form class="omb_loginForm" action="" autocomplete="off" method="post">

                    @Html.HiddenFor(kh => kh.Id)
                    @Html.HiddenFor(kh => kh.HoTen)
                    @Html.HiddenFor(kh => kh.IdVitrinhanvien)
                    @Html.HiddenFor(kh => kh.NgayUpdate)
                    <h4 class="info_header">
                        <span class="pull-right label label-warning" style="color:white;font-family:monospace">
                            @Html.ValidationSummary()
                        </span>
                    </h4>
                    <div class="contentform">
                        <div class="form-group">
                            <div class="row" style="width:95%;padding-left:15px">
                                <div class="col-md-4">
                                    <p>Số CCCD</p>
                                    @Html.TextBoxFor(m => m.CCCD, new { @class = "form-control", style = "height: 40px", @required = true })

                                </div>
                                <div class="col-md-4" style="text-align:center">
                                    <p>Nam</p>
                                    @Html.CheckBoxFor(m => m.GioiTinh, new { @class = "form-control", style = "height: 40px;margin-left:40px" })

                                </div>
                                <div class="col-md-4">
                                    <p>SDT</p>
                                    @Html.TextBoxFor(m => m.Sdt, new { @class = "form-control", style = "height: 40px" })

                                </div>
                            </div>
                        </div>
                            <div class="row" style="width:95%;padding-left:15px">
                                <div class="col-md-4">
                                    <p>ThuongTru</p>
                                    @Html.DropDownList("IdKhuVucThuongTru", null, new { style = "width: 100%; height: 40px" })
                                </div>
                                <div class="col-md-8">
                                    <p>Đc ThuongTru</p>
                                    @Html.TextBoxFor(m => m.DiaChiThuongTru, new { @class = "form-control", style = "height: 40px", @required = true })

                                </div>
                            </div>
                            <div class="row" style="width:95%;padding-left:15px">
                                <p>Đc Hiện Tại</p>
                                @Html.TextBoxFor(m => m.DiaChiHienTai, new { @class = "form-control", style = "height: 40px", @required = true })

                            </div>
                            <div class="row" style="width:95%;padding-left:15px">
                                <p>Kinh nghiệm đã làm </p>
                                <span class="icon-case"><i class="glyphicon glyphicon-ice-lolly-tasted"></i></span>
                                @Html.TextBoxFor(m => m.CongViec, new { @class = "form-control", style = "height: 40px" })

                            </div>
                            <div class="row" style="width:95%;padding-left:15px">
                                <p>Bằng Cấp Chính </p>
                                <span class="icon-case"><i class="glyphicon glyphicon-education"></i></span>
                                @Html.TextBoxFor(m => m.BangCapChinh, new { @class = "form-control", style = "height: 40px" })
                            </div>
                            <div class="row" style="width:95%;padding-left:15px">
                                <div class="col-sm-6">
                                    <p>Bằng Cấp Phụ </p>
                                    @Html.TextBoxFor(m => m.BangCapPhu, new { @class = "form-control", style = "height: 40px" })
                                </div>
                                <div class="col-sm-6">
                                    <p>Tin Học </p>
                                    @Html.TextBoxFor(m => m.TinHoc, new { @class = "form-control", style = "height: 40px" })
                                </div>
                            </div>
                            <div class="row" style="width:95%;padding-left:15px">
                                <div class="col-sm-6">
                                    <p>Ngày Vào Cty</p>
                                    <span class="icon-case"><i class="glyphicon glyphicon-time"></i></span>
                                    @Html.TextBoxFor(kh => kh.NgayTao, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", style = "height: 40px", @disabled=true })
                                </div>
                                <div class="col-sm-6">
                                    <p>Ngày Update</p>
                                    <span class="icon-case"><i class="glyphicon glyphicon-time"></i></span>
                                    @Html.TextBoxFor(kh => kh.NgayUpdate, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", style = "height: 40px", @disabled = true })
                                </div>
                            </div>
                            <div class="input-group" style="width:100%;margin-bottom:15px;margin-top:15px">
                                <div style="width: 49%; border: 1px dashed #423333; float: left">
                                    <label class="checkbox text-danger" style="margin-left:5px">
                                        <input type="checkbox" id="ND" dirname="" value="" name="Check" />
                                        <span>Thay đổi pass word</span>
                                    </label>
                                </div>

                            </div>
                            <div class="row" id="pwc" style="width:95%;padding-left:15px;display:none">
                                <p>PassWord củ</p>
                                <input type="text" id="PW" value="" name="PW" required />
                                <span class="label label-warning" id="thongbaopwc"></span>
                            </div>
                            <div class="row" id="pwm" style="width: 95%; padding-left: 15px; display: none">
                                <p>PassWord mới</p>
                                <input type="text" id="PWM" name="PWM" required />
                                <span class="label label-warning" id="thongbaopwm"></span>
                            </div>
                            <div class="row" id="lpwm" style="width: 95%; padding-left: 15px; display: none">
                                <p>Lặp lại PassWord mới</p>
                                <input type="text" id="PWMM" name="PWMM" required />
                                <span class="label label-warning" id="thongbaolpwm"></span>
                            </div>

                            <div class="row" style="margin-top:20px">
                                <div class="form-group col-sm-12">
                                    <div class="btn-crud">
                                        <a id="btnLuu" class="btn btn-warning" onclick="UpdateThongtin()"><span class="glyphicon glyphicon-refresh"></span>&nbsp;Update User</a>
                                        <a class="btn btn-primary" href="/Active/IndexDL" style="margin-left:10%"><span class="glyphicon glyphicon-arrow-left"></span>&nbsp;Quay Lại</a>
                                    </div>

                                </div>
                            </div>
                        

                        </div>
                </form>
            </div>
        </div>

    }
</div>
<script>
    $("input:checkbox").on('click', function () {
        var $box = $(this);
        if ($box.is(":checked")) {
            $("#pwc").css('display', 'block')
            $("#pwm").css('display', 'block')
            $("#lpwm").css('display', 'block')
        } else {
            $("#pwc").css('display', 'none')
            $("#pwm").css('display', 'none')
            $("#lpwm").css('display', 'none')
        }
    });
    function UpdateThongtin() {
        var check = $("#ND");
        var ischeck = "false";
        var id = $("#Id").val();
        var daidien = $("#DaiDien").val();
        var diachi = $("#DiaChi").val();
        var sdt = $("#SDT").val();
        var gmail = $("#Gmail").val();
        var pw = $("#PW").val();
        var pwm = $("#PWM").val();
        var pwmm = $("#PWMM").val();

        if (check.is(":checked")) {
            if (!confirm("Bạn muốn thay đổi thông tin của Chi Nhánh và PassWord ??")) {
                return false;
            } else {
                if (pw == null || pw.trim() == "") {
                    $("#thongbaopwc").html("Pass word của bạn là gì ??")
                } else if (pwm == null || pwm.trim() == "") {
                    $("#thongbaopwm").html("Pass word mới không để trống !!!")
                } else if (pwmm == null || pwmm.trim() == "" || pwmm.trim() != pwm) {
                    $("#thongbaolpwm").html("Lặp lại Pass word không đúng !!!")
                } else {
                    var postData = JSON.stringify({
                        Id: id, DaiDien: daidien, SDT: sdt, DiaChi: diachi, Gmail: gmail
                        , PW: pw, PWM: pwm, PWMM: pwmm
                    });
                    $.ajax({
                        contentType: "application/json; charset=utf-8",
                        url: "/AccountWeb/ChangeInFoJson",
                        dataType: 'json',
                        type: 'POST',
                        data: postData,
                        success: function (response) {
                            location.reload();
                        }
                    });
                }

            }
        }
     }
</script>



