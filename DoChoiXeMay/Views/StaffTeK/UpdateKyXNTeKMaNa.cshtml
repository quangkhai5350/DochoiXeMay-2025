@model DoChoiXeMay.Models.KyXuatNhap
@{
    ViewBag.Title = "UpdateKyXNTeKMaNa";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.0/css/bootstrap.min.css">
<link href="~/Content/Login_Style.css" rel="stylesheet" />
<script src="~/Areas/Admin/Content/jquery2.0.3.min.js"></script>
<div class="container" style="width:100%;background-color: white; margin-top: 150px; border-radius: 4px 4px; box-shadow: 0px 2px 4px 0px rgba(0,0,0,0.32);">

    <div class="omb_login" style="text-align:center">
        <h3><a style="text-decoration: none">Update Hình Sp: @Model.TenKy</a></h3>
    </div>
    @using (Html.BeginForm("UpdateKyXNTeKMaNa", "StaffTeK", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <div class="row col-md-offset-2">
            <form class="omb_loginForm" action="" autocomplete="off" method="post">
                @Html.HiddenFor(kh => kh.Id)
                @Html.HiddenFor(kh => kh.TenKy)
                @Html.HiddenFor(kh => kh.XuatNhap)
                @Html.HiddenFor(kh => kh.CKphantram)
                @Html.HiddenFor(kh => kh.CKtienmat)
                @Html.HiddenFor(kh => kh.Shipper)
                @Html.HiddenFor(kh => kh.VAT)
                @Html.HiddenFor(kh => kh.IdMaTC)
                @Html.HiddenFor(kh => kh.UserId)
                @Html.HiddenFor(kh => kh.UPush)
                @Html.HiddenFor(kh => kh.AdminXNPUSH)
                @Html.HiddenFor(kh => kh.UYeuCauThuHoi)
                @Html.HiddenFor(kh => kh.NgayAuto)
                @Html.HiddenFor(kh => kh.TongTienAuto)
                @Html.HiddenFor(kh => kh.NgayXuatNhap)
                @Html.HiddenFor(kh => kh.LuuKho)
                @Html.HiddenFor(kh => kh.STT)
                @Html.HiddenFor(kh => kh.KhachLe)
                @Html.HiddenFor(kh => kh.IdKyTonKho)
                @Html.HiddenFor(kh => kh.IdSan)
                @Html.HiddenFor(kh => kh.IdKhuVuc)
                @Html.HiddenFor(kh => kh.IdLoaiHangXN)
                <div class="contentform">
                    <div class="form-group">
                        <div class="row" style="padding-left: 15px">
                            <div class="col-sm-7 col-xs-8">
                                <div class="form-group">
                                    <p>Hình 3 (giới hạn 7MB) <span></span></p>
                                    <input type="file" name="Dinhkem1" id="Dinhkem1" style="border: 1px solid #b4a3a3" />
                                    <p id="thongbaosite1" style="color:red; display:none">File quá lớn !!!</p>
                                    @Html.HiddenFor(kh => kh.HoaDon)
                                </div>
                            </div>
                            <div class="col-sm-3 col-xs-4">
                                @if (File.Exists(Request.MapPath("~/Content/imgxuatnhap/" + Model.HoaDon)))
                                {
                                    <img class="img-responsive img-thumbnail" src="~/Content/imgxuatnhap/@Model.HoaDon" style="max-width:100%;max-height:100px" />
                                }
                            </div>
                        </div>
                        <div class="row" style="padding-left: 15px">
                            <div class="col-sm-7 col-xs-8">
                                <div class="form-group">
                                    <p>Hình 2 (giới hạn 7MB) <span></span></p>
                                    <input type="file" name="Dinhkem2" id="Dinhkem2" style="border: 1px solid #b4a3a3" />
                                    <p id="thongbaosite2" style="color:red; display:none">File quá lớn !!!</p>
                                    @Html.HiddenFor(kh => kh.Filesave2)
                                </div>
                            </div>
                            <div class="col-sm-3 col-xs-4">
                                @if (File.Exists(Request.MapPath("~/Content/imgxuatnhap/" + Model.Filesave2)))
                                {
                                    <img class="img-responsive img-thumbnail" src="~/Content/imgxuatnhap/@Model.Filesave2" style="max-width:100%;max-height:80px" />
                                }
                            </div>
                        </div>
                        <div class="row" style="padding-left: 15px">
                            <div class="col-sm-7 col-xs-8">
                                <div class="form-group">
                                    <p>Hình 1 (giới hạn 7MB) <span></span></p>
                                    <input type="file" name="Dinhkem3" id="Dinhkem3" style="border: 1px solid #b4a3a3" />
                                    <p id="thongbaosite3" style="color:red; display:none">File quá lớn !!!</p>
                                    @Html.HiddenFor(kh => kh.Filesave3)
                                </div>
                            </div>
                            <div class="col-sm-3 col-xs-4">
                                @if (File.Exists(Request.MapPath("~/Content/imgxuatnhap/" + Model.Filesave3)))
                                {
                                    <img class="img-responsive img-thumbnail" src="~/Content/imgxuatnhap/@Model.Filesave3" style="max-width:100%;max-height:80px" />
                                }
                            </div>
                        </div>
                        <script>
                            var kt1 = true;
                            var kt2 = true;
                            var kt3 = true;
                            $('#Dinhkem1').bind('change', function () {
                                //this.files[0].size gets the size of your file.
                                var size = this.files[0].size;
                                const file = Math.round((size / 1024));
                                if (file >= 7200) {
                                    $("#thongbaosite1").css('display', 'block');
                                    kt1 = false;
                                    KtLuu();
                                } else {
                                    $("#thongbaosite1").css('display', 'none')
                                    kt1 = true;
                                    KtLuu();
                                }
                            });
                            $('#Dinhkem2').bind('change', function () {
                                //this.files[0].size gets the size of your file.
                                var size = this.files[0].size;
                                const file = Math.round((size / 1024));
                                if (file >= 7200) {
                                    $("#thongbaosite2").css('display', 'block');
                                    kt2 = false;
                                    KtLuu();
                                } else {
                                    $("#thongbaosite2").css('display', 'none')
                                    kt2 = true;
                                    KtLuu();
                                }
                            });
                            $('#Dinhkem3').bind('change', function () {
                                //this.files[0].size gets the size of your file.
                                var size = this.files[0].size;
                                const file = Math.round((size / 1024));
                                if (file >= 7200) {
                                    $("#thongbaosite3").css('display', 'block');
                                    kt3 = false;
                                    KtLuu();
                                } else {
                                    $("#thongbaosite3").css('display', 'none')
                                    kt3 = true;
                                    KtLuu();
                                }
                            });
                            function KtLuu() {
                                if (kt1 == true && kt2 == true && kt3 == true) {
                                    document.getElementById('btnLuu').disabled = false;
                                } else {
                                    document.getElementById('btnLuu').disabled = true;
                                }
                            }
                            
                        </script>
                        <div class="row" style="margin-top: 20px; padding-left: 15px">
                            <div class="form-group col-sm-12">
                                <div class="btn-crud">
                                    <button id="btnLuu" class="btn btn-warning" data-action="UpdateKyXNTeKMaNa"><span class="glyphicon glyphicon-refresh"></span>&nbsp;Update Hình</button>
                                    <a class="btn btn-primary" href="/StaffTeK/IndexStaff" style="margin-left:10%"><span class="glyphicon glyphicon-arrow-left"></span>&nbsp;Quay Lại</a>
                                </div>
                                
                            </div>
                        </div>
                    </div>
                    <h4 class="info_header">
                        <span class="pull-right label label-warning" style="color:white;font-family:monospace">
                            @Html.ValidationSummary()
                        </span>
                    </h4>
                </div>

</form>
        </div>
             }
</div>
<script>
    $(function () {
        
            $("button[data-action]").click(function () {
                if (!confirm("Bạn Có Chắc Chắn Hành Động Của Mình?")) {
                    return false;
                } else {
                    var action = $(this).attr("data-action");
                    this.form.action = "/StaffTeK/" + action;
                }
            });
    });
</script>