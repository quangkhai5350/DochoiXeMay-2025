@model DoChoiXeMay.Models.NV_GioCong

@{
    ViewBag.Title = "UpdateGioCong";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.0/css/bootstrap.min.css">

<link href="~/Content/Login_Style.css" rel="stylesheet" />
<script src="~/Areas/Admin/Content/jquery2.0.3.min.js"></script>
<div class="container" style="width:100%;background-color: white; margin-top: 150px; border-radius: 4px 4px; box-shadow: 0px 2px 4px 0px rgba(0,0,0,0.32);">
    <div class="omb_login">
        <div class="row" style="text-align:center">
            <span style="font-size:15px" class="pull-right label label-warning">@Session["ThongbaoUthanhcong"]</span>
        </div>
    </div>
    @if (Model != null)
    {
        <div class="omb_login" style="text-align:center">
            <h3><a style="text-decoration: none">Update thông tin Giờ ngày: @Model.Day/@Model.Month/@Model.Year</a></h3>
        </div>
    }
    @using (Html.BeginForm("UpdateGioCong", "StaffTeK", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <h4 class="info_header">
    <span class="pull-right label label-warning" style="color:white;font-family:monospace">
        @Html.ValidationSummary()
    </span>
</h4>
        <div class="row col-md-offset-2">
            <div class="col-md-10 col-xs-12 col-sm-12" style="padding-bottom:10px">
                <form class="omb_loginForm" action="" autocomplete="off" method="post">
                    @Html.HiddenFor(kh => kh.Id)
                    @Html.HiddenFor(kh => kh.IdNhanVien)
                    @Html.HiddenFor(kh => kh.Day)
                    @Html.HiddenFor(kh => kh.Month)
                    @Html.HiddenFor(kh => kh.Year)
                    @Html.HiddenFor(kh => kh.GhiChu)
                    @Html.HiddenFor(kh => kh.NgayUpdate)
                    
                    <div class="contentform">
                        <div class="form-group">
                            <div class="row">
                                <div class="col-md-6 col-sm-6">
                                    <p>GioVaoSang</p>
                                    <input name="VaoSang" value="@Model.GioVaoSang.TimeOfDay" class="form-control" type="time" />
                                    @Html.HiddenFor(kh => kh.GioVaoSang)
                                </div>
                                <div class="col-md-6 col-sm-6">
                                    <p>GioRaSang</p>
                                    <input name="RaSang" value="@Model.GioRaSang.TimeOfDay" class="form-control" type="time" />
                                    @Html.HiddenFor(kh => kh.GioRaSang)
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="row">
                                <div class="col-md-6 col-sm-6">
                                    <p>GioVaoChieu</p>
                                    <input name="VaoChieu" value="@Model.GioVaoChieu.TimeOfDay" class="form-control" type="time" />
                                    @Html.HiddenFor(kh => kh.GioVaoChieu)
                                </div>
                                <div class="col-md-6 col-sm-6">
                                    <p>GioRaChieu</p>
                                    <input name="RaChieu" value="@Model.GioRaChieu.TimeOfDay" class="form-control" type="time" />
                                    @Html.HiddenFor(kh => kh.GioRaChieu)
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="form-group">
                            <div class="row">
                                <div class="col-md-6 col-sm-6">
                                    <p>GioVaoTangCa</p>
                                    <input name="VaoTangCa" value="@Model.GioVaoTangCa.TimeOfDay" class="form-control" type="time" />
                                    @Html.HiddenFor(kh => kh.GioVaoTangCa)
                                </div>
                                <div class="col-md-6 col-sm-6">
                                    <p>GioRaTangCa</p>
                                    <input name="RaTangCa" value="@Model.GioRaTangCa.TimeOfDay" class="form-control" type="time" />
                                    @Html.HiddenFor(kh => kh.GioRaTangCa)
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="row">
                                <div class="col-md-6 col-sm-6">
                                    <p>GioVaoLe</p>
                                    <input name="VaoLe" value="@Model.GioVaoLe.TimeOfDay" class="form-control" type="time" />
                                    @Html.HiddenFor(kh => kh.GioVaoLe)
                                </div>
                                <div class="col-md-6 col-sm-6">
                                    <p>GioRaLe</p>
                                    <input name="RaLe" value="@Model.GioRaLe.TimeOfDay" class="form-control" type="time" />
                                    @Html.HiddenFor(kh => kh.GioRaLe)
                                </div>
                            </div>
                        </div>
                        <div class="row" style="margin-top:10px">
                            <div class="form-group col-sm-12">
                                <div class="text-center btn-crud">
                                    <button id="btnLuu" class="btn btn-warning" data-action="UpdateGioCong"><span class="glyphicon glyphicon-refresh"></span>&nbsp;Update</button>
                                    <a class="btn btn-primary" href="/StaffTeK/IndexStaff" style="margin-left:10%"><span class="glyphicon glyphicon-arrow-left"></span>&nbsp;Quay Lại</a>
                                </div>
                                <script>
                                    $(function () {
                                        $("button[data-action]").click(function () {
                                            if (!confirm("Bạn Có Chắc Chắn Hành Động Của Mình?")) {
                                                return false;
                                            } else {
                                                var action = $(this).attr("data-action");
                                                this.form.action = "/StaffTeK/" + action;
                                            }

                                        });
                                    });
                                </script>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        
            }
        </div>
