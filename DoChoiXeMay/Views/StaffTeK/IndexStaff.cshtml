@using DoChoiXeMay.Models
@{
    ViewBag.Title = "IndexStaff";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.0/css/bootstrap.min.css">

<link href="~/Content/Login_Style.css" rel="stylesheet" />

<div class="container" style="width:100%;background-color: white; margin-top: 80px; border-radius: 4px 4px; box-shadow: 0px 2px 4px 0px rgba(0,0,0,0.32)">
    <div class="omb_login">
        <div class="pull-right label-warning" style="margin-bottom: 5px; color: white; font-family: monospace; font-weight: bold; font-size: large">
            @Session["ThongbaoNVLoi"]
        </div>
        <div class="pull-right label-success" style="margin-bottom: 5px; color: white; font-family: monospace; font-weight: bold; font-size: large">
            @Session["ThongbaoNV"]
        </div>
    </div>
</div>
<div class="" style="width:100%;background-color: white; margin-top: 80px; border-radius: 4px 4px; box-shadow: 0px 2px 4px 0px rgba(0,0,0,0.32)">
    <h3 style="text-align:center"><a style="text-decoration: none">Xem va Update Giờ Công @ViewBag.Hoten</a></h3>
    <h5 style="text-align:center"><a style="text-decoration: none">(Ngày làm 4h trở lên thì sẽ có cơm trưa.)</a></h5>
    <h5 style="text-align:center"><a style="text-decoration: none">(Chiều bắt đầu lúc 1h - Ca Tối lúc 6h.)</a></h5>
    <div class="row" style="margin-top:20px;margin-bottom:10px">
        <div class="col-lg-6 col-xl-6 col-md-6 col-sm-12 col-12" style="margin-left: 10px">
            <span class="icon-case"><i class="glyphicon glyphicon-calendar"></i>Chọn Tháng Năm</span>
            <input type="month" name="ThangNam" value="@DateTime.Now.ToString("yyyy-MM")" id="ThangNam" />
        </div>
    </div>
    <div class="listGioCongNV">

    </div>
</div>
<div class="omb_login">
    <div class="pull-right label-warning" style="margin-bottom: 5px; color: white; font-family: monospace; font-weight: bold; font-size: large">
        @Session["ThongbaoLTLoi"]
    </div>
    <div class="pull-right label-success" style="margin-bottom: 5px; color: white; font-family: monospace; font-weight: bold; font-size: large">
        @Session["ThongbaoLT"]
    </div>
</div>
<div class="" style="width:100%;background-color: white; margin-top: 80px; border-radius: 4px 4px; box-shadow: 0px 2px 4px 0px rgba(0,0,0,0.32)">
    <h3 style="text-align:center"><a style="text-decoration: none">Lịch làm việc tuần của @ViewBag.Hoten</a></h3>
    <div class="row" style="margin-top:20px;margin-bottom:10px">

        <div class="col-lg-4 col-xl-4 col-md-4 col-sm-6" style="margin-top:10px">
            <select class="form-control" id="SelectW" name="SelectW" style="width: 70%; height: 40px; margin: 0 auto">
                <option value="@ViewBag.Tuanmoihon">Tuần @ViewBag.Tuanmoihon</option>
                <option value="@ViewBag.Tuanmoi">Tuần @ViewBag.Tuanmoi</option>
                <option value="@ViewBag.TuanHT" selected>Tuần(@ViewBag.TuanHT) Hiện tại</option>
                <option value="@ViewBag.TuanCu1">Tuần @ViewBag.TuanCu1</option>
                <option value="@ViewBag.TuanCu2">Tuần @ViewBag.TuanCu2</option>
                <option value="@ViewBag.TuanCu3">Tuần @ViewBag.TuanCu3</option>
                <option value="@ViewBag.TuanCu4">Tuần @ViewBag.TuanCu4</option>
            </select>
        </div>
        <input id="CheckTHT" value="@ViewBag.TuanHT" hidden />
    </div>
    <div class="listLichTuanNV">

    </div>
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 col-6" style="margin-bottom:10px">
        <button id="alich" class="btn btn-warning" data-action="UpdateLichTuan" style="margin-left:5px">
            <i class="fa fa-plus-circle"></i>&nbsp;&nbsp; <span id="namelich">Update "Lịch Làm Việc"</span>
        </button>
    </div>
</div>
@if (Session["quyen"].ToString() == "4")
{
    <div class="" style="width:100%;background-color: white; margin-top: 80px; border-radius: 4px 4px; box-shadow: 0px 2px 4px 0px rgba(0,0,0,0.32)">
        <div class="omb_login">
            <div class="pull-right label-warning" style="margin-bottom: 5px; color: white; font-family: monospace; font-weight: bold; font-size: large">
                @Session["ThongbaoUphinhLoi"]
            </div>
            <div class="pull-right label-success" style="margin-bottom: 5px; color: white; font-family: monospace; font-weight: bold; font-size: large">
                @Session["ThongbaoUphinh"]
            </div>
        </div>
        <h3 style="text-align:center"><a style="text-decoration: none">Danh Sách sp đã xuất ngày: @DateTime.Now.ToString("dd/MM/yyyy")</a></h3>
        <div class="SPDaBan">

        </div>
    </div>
}

<script src="//ajax.googleapis.com/ajax/libs/jquery/1.9.1/jquery.min.js"></script>
<script>
    Load();
    function Load() {
        InsertAutoNgayThang();
        GetListTuan();
        GetListKyXNTeKMaNa()
    }
    $(function () {
        $("button[data-action]").click(function () {
            if (!confirm("Bạn Có Chắc Chắn Hành Động Của Mình?")) {
                return false;
            } else {
                var week = $('#SelectW').val();
                var action = $(this).attr("data-action");
                //this.form.action = "/StaffTeK/UpdateLichTuan/" + action + "?week=" + week;
                var url = "@Url.Action("UpdateLichTuan", "StaffTeK")?week=" + week;
                window.location.href = url;
            }
        });
    });

    function InsertAutoNgayThang() {
        var tn = $('#ThangNam').val();
        var week = $('#SelectW').val();
        $.ajax({
            url: "/StaffTeK/InsertAutoNgayThang",
            type: 'POST',
            datatype: 'JSON',
            contentType: 'application/json;charset=utf-8;',
            data: JSON.stringify({ dtInput: tn }),
            async: true,
            success: function (res) {
                GetListTinhGio();

            }, error: function (err) {
                GetListTinhGio();
                console.log(err, ':Loi Check Thêm Ngày Tháng');
            }
        });
    }
    function GetListTinhGio() {
        var tn = $('#ThangNam').val();
        $.ajax({
            url: "/StaffTeK/GetListTinhGioCong",
            data: { dtInput: tn },
            success: function (respone) {
                $(".listGioCongNV").html(respone);
                //var pagesp = pageNo + 1;
                //$('.TongSanPham').html(pagesp + '/' + TongSP + ' trang');
            }, error: function (err) {
                console.log(err, ':Loi get List');
            }
        });
    }
    function GetListTuan() {
        var week = $('#SelectW').val();
        var namel = $('#namelich').html();
        $.ajax({
            url: "/StaffTeK/GetListTuan",
            data: {tuanht: week},
            success: function (respone) {
                $(".listLichTuanNV").html(respone);
                $('#namelich').html('Update Lịch Làm Việc Tuần (' + week+')');
                //var pagesp = pageNo + 1;
                //$('.TongSanPham').html(pagesp + '/' + TongSP + ' trang');
            }, error: function (err) {
                console.log(err, ':Loi get List');
            }
        });
    }
    $("#ThangNam").change(function () {
        var tn = $('#ThangNam').val();
        InsertAutoNgayThang();
        //var tn = $('#ThangNam').val();
        //var namTh = tn.split("-");
        //khi load trang ==> controler ==> tạo ra n dòng(số ngày trong tháng đến hiện tại)
        //Khi đổi nhân viên ==> controler ==> tạo ra n dòng(số ngày trong tháng đến hiện tại)
    });
    $("#SelectW").change(function () {
        var week = $('#SelectW').val();
        var chek = $('#CheckTHT').val();
        if (week < chek) {
            $('#alich').addClass("disabled");

        } else {
            $('#alich').removeClass("disabled");
        }
        $('#namelich').html('Update Lịch Làm Việc Tuần (' + week + ')');
        GetListTuan();
    });
    function GetListKyXNTeKMaNa() {
        $.ajax({
            url: "/StaffTeK/GetListKyXNTeKMaNa",
            data: {},
            success: function (respone) {
                $(".SPDaBan").html(respone);
            }
        });
    };
</script>

