@using DoChoiXeMay.Models

<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.0/css/bootstrap.min.css">

<link href="~/Content/Login_Style.css" rel="stylesheet" />
@{
    ViewBag.Title = "IndexStaff";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container" style="width:100%;background-color: white; margin-top: 80px; border-radius: 4px 4px; box-shadow: 0px 2px 4px 0px rgba(0,0,0,0.32);">
    <div class="omb_login">
        <div class="pull-right label label-warning" style="margin-bottom: 5px; color: white; font-family: monospace; font-weight: bold; font-size: large">
            @Session["ThongbaoNVLoi"]
        </div>
        <div class="pull-right label label-success" style="margin-bottom: 5px; color: white; font-family: monospace; font-weight: bold; font-size: large">
            @Session["ThongbaoNV"]
        </div>
    </div>
    <div class="panel-body">
        <h3 style="text-align:center"><a style="text-decoration: none">Xem va Update Giờ Công @ViewBag.Hoten</a></h3>
        <div class="row" style="margin-top:20px;margin-bottom:10px">
            <div class="col-lg-6 col-xl-6 col-md-6 col-sm-12 col-12" style="">
                <span class="icon-case"><i class="glyphicon glyphicon-calendar"></i>Chọn Tháng Năm</span>
                <input type="month" name="ThangNam" value="@DateTime.Now.ToString("yyyy-MM")" id="ThangNam" />
            </div>
        </div>
        <div class="listGioCongNV">

        </div>
    </div>
</div>
<script src="//ajax.googleapis.com/ajax/libs/jquery/1.9.1/jquery.min.js"></script>
<script>
    GetListTinhGio();
    function GetListTinhGio() {
        var tn = $('#ThangNam').val();
        $.ajax({
            url: "/StaffTeK/GetListTinhGioCong",
            data: { dtInput: tn},
            success: function (respone) {
                $(".listGioCongNV").html(respone);
                //var pagesp = pageNo + 1;
                //$('.TongSanPham').html(pagesp + '/' + TongSP + ' trang');
            }, error: function (err) {
                console.log(err, ':Loi get List');
            }
        });
    }
</script>

