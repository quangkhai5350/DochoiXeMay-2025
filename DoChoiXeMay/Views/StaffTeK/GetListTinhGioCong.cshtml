@model IEnumerable<DoChoiXeMay.Models.NV_GioCong>
<script src="~/Areas/Admin/Content/jquery2.0.3.min.js"></script>
<style>
    .tomau {
        background-color: darkkhaki;
    }
</style>
<div class="table-responsive">
    <table class="table">
        <thead>
            <tr style="background-color: #00bcd4">
                <th style="width:40px">@ViewBag.TongSoSoGioThang h</th>
                <th style="width:100px !important;text-align:center">Update</th>
                <th>VaoS</th>
                <th>RaS</th>
                <th>VaoC</th>
                <th>RaC</th>
                <th>V-TCa</th>
                <th>R-TCa</th>

                <th>V-Le</th>
                <th>R-Le</th>
                <th>NgayUpdate</th>

            </tr>
        </thead>
        @foreach (DoChoiXeMay.Models.NV_GioCong item in ViewBag.NgayGioCong)
        {
            var Id = item.Id.ToString();
            var cl = "";
            var ht = DateTime.Now;
            if (item.GhiChu == "0,00")
            {
                cl = "";
            }
            else
            {
                cl = "tomau";
            }
            <tr class="@cl">
                <td>
                    @Html.DisplayFor(modelItem => item.GhiChu)
                </td>
                <td>
                    @if (item.Day == ht.Day && item.Month == ht.Month && item.Year == ht.Year)
                    {
                        <a class="btn btn-warning" style="" href="/StaffTeK/UpdateGioCong/@item.Id"><i class="fa fa-pencil-square-o"></i>&nbsp;&nbsp;(@item.Day/@item.Month)</a>
                    }
                    else
                    {
                        <a class="btn btn-warning" style="" disabled><i class="fa fa-pencil-square-o"></i>&nbsp;&nbsp;(@item.Day/@item.Month)</a>
                    }
                </td>
                <td>
                    @item.GioVaoSang.ToString("HH:mm")
                </td>
                <td>
                    @item.GioRaSang.ToString("HH:mm")
                </td>
                <td>
                    @item.GioVaoChieu.ToString("HH:mm")
                </td>
                <td>
                    @item.GioRaChieu.ToString("HH:mm")
                </td>

                <td>
                    @item.GioVaoTangCa.ToString("HH:mm")
                </td>
                <td>
                    @item.GioRaTangCa.ToString("HH:mm")
                </td>
                <td>
                    @item.GioVaoLe.ToString("HH:mm")
                </td>
                <td>
                    @item.GioRaLe.ToString("HH:mm")
                </td>
                <td>
                    @Html.FormatValue(item.NgayUpdate, "{0:dd/MM/yyyy}")
                </td>
            </tr>
        }

    </table>
</div>


